import {
  "moonbitlang/core/math" @math,
  "moonbitlang/core/double" @double,
}

import {
  "mizchi/numbt" @numbt,
} for "test"

// `mizchi/numbt` is a test-only import (used to cross-validate matrix products
// in matrix_game_test.mbt). However, because numbt links against BLAS, the
// `cc-link-flags` below propagate to any package that depends on this one at
// `moon build` time as well — so consumers must provide BLAS even for non-test
// builds. The default below is macOS-only; CI / cross-platform consumers must
// rewrite this file in place before `moon build` / `moon test`.
//
// MoonBit exposes no env var to override link flags (only MOON_CC / MOON_AR
// reach the build). Recommended replacements:
//   Linux:   -lopenblas -llapack -lm
//   macOS:   -framework Accelerate (matches default below; no rewrite needed)
//   Windows: -LC:/msys64/mingw64/lib -lopenblas (MSYS2-installed; CI sets
//            MOON_CC to a mingw-w64 gcc.exe)
options(
  link: { "native": { "cc-link-flags": "-framework Accelerate" } },
  "supported-targets": "native",
)
